# ============================================================================
# Play Music — Configuração (play-music)
# ============================================================================
# MODELO (.env.example) — copie para .env e preencha os valores reais.
# O .env NUNCA é versionado (ver .gitignore). Toda configuração do app vem
# do ambiente: variáveis com prefixo ND_ + DATABASE_URL. Este arquivo é a
# referência de quais variáveis existem; os valores abaixo são placeholders.
#
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
#
# O backend NÃO carrega .env automaticamente: use o docker-compose
# (env_file: .env) ou um script que exporte as variáveis (ex.: m1-start.ps1).

# --- Idiomas / Interface -----------------------------------------------------
ND_DEFAULTLANGUAGE=pt-BR
ND_DEFAULTTHEME=Dark

# --- Administrador (fonte unica das credenciais) ------------------------------
ND_ADMINUSERNAME=admin
ND_ADMINPASSWORD=<troque-esta-senha>

# --- Biblioteca / Storage (Bunny Storage Zone "files3", S3-compatible) ---------
# A biblioteca fica na Storage Zone "files3" do Bunny (S3 origin da Pull Zone).
ND_S3_ENDPOINT=jh-s3.storage.bunnycdn.com
ND_S3_ACCESSKEY=files3
ND_S3_SECRETKEY=<bunny-storage-secret-key>
ND_S3_BUCKET=files3
ND_S3_REGION=us-east-1
ND_S3_SECURE=true

# ND_MUSICFOLDER (apenas local/opcional) — mesmo destino das ND_S3_* acima:
ND_MUSICFOLDER=s3://files3?endpoint=jh-s3.storage.bunnycdn.com&accessKey=files3&secretKey=<bunny-storage-secret-key>&region=us-east-1&secure=true

# --- Redis (se usado) ----------------------------------------------------------
ND_REDIS_ENABLED=true
ND_REDIS_URL=redis://<user>:<password>@<host>:6379/0

# --- Bunny CDN — Pull Zone (aponta para a Storage Zone "files3") ---------------
ND_CDN_ENABLED=true
ND_CDN_BASEURL=https://files.nuvexaia.online
ND_CDN_TOKENAUTHKEY=<bunny-token-auth-key>
ND_CDN_TOKENTTL=24h
ND_CDN_ADVANCEDAUTH=true
ND_CDN_PATH_PREFIX=

# --- Postgres -------------------------------------------------------------------
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>?sslmode=disable

# --- Frontend -------------------------------------------------------------------
# URL base da API vista pelo navegador. VAZIO = mesmo domínio do frontend.
ND_FRONTEND_BASEURL=

# --- Loja (preços/links de checkout injetados em /loja.html) --------------------
# JSON com { categories: { '<Nome>': { price, url } }, packs: [{ name, price, url,
# categories: [...], desc }] }. Deixe vazio para ocultar preços/links.
# IMPORTANTE: mantenha o JSON 100% ASCII — acentos como escapes \uXXXX
# (ex.: ã = \u00e3, ç = \u00e7) para sobreviver a qualquer loader de .env.
ND_STORE_CONFIG_JSON={"categories":{"Crist\u00e3o":{"price":"R$ 9,90","url":"https://checkout.exemplo.com/cristao"}},"packs":[{"name":"Pacote Completo","price":"R$ 19,90","url":"https://checkout.exemplo.com/pacote-completo","categories":["Crist\u00e3o"],"desc":"Todas as categorias por um pre\u00e7o especial."}]}

# --- ffmpeg ---------------------------------------------------------------------
# Em produção o ffmpeg vem na imagem Docker. Localmente, informe o caminho se
# não estiver no PATH.
# ND_FFMPEGPATH=C:\ffmpeg\bin\ffmpeg.exe

# --- Avançado -------------------------------------------------------------------
ND_LOGLEVEL=info
ND_PORT=4533
ND_ADDRESS=0.0.0.0
ND_SCANNER_SCHEDULE=@every 1h
ND_TRANSCODINGCACHESIZE=500MiB
ND_IMAGECACHESIZE=100MB
ND_ENABLEINSIGHTSCOLLECTOR=false
