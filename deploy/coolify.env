# Template de variáveis de ambiente para o Coolify (Play Music).
# Preencha/confira os valores reais no Coolify (Environment Variables).

# --- Biblioteca no MinIO (S3) ---
ND_MUSICFOLDER=s3://play-music?endpoint=minios3.centralcursoss.com.br&accessKey=SEU_ACCESS_KEY&secretKey=SEU_SECRET_KEY&secure=true

# --- MinIO (backend S3) ---
ND_S3_ENDPOINT=minios3.centralcursoss.com.br
ND_S3_ACCESSKEY=SEU_ACCESS_KEY
ND_S3_SECRETKEY=SEU_SECRET_KEY
ND_S3_BUCKET=play-music
ND_S3_REGION=us-east-1
ND_S3_SECURE=true

# --- Redis ---
ND_REDIS_ENABLED=true
ND_REDIS_URL=redis://default:SUA_SENHA_REDIS@SEU_REDIS_HOST:6379/0

# --- Bunny CDN (Pull Zone -> MinIO, S3 origin) ---
ND_CDN_ENABLED=true
ND_CDN_BASEURL=https://music.centralcursoss.com.br
ND_CDN_TOKENAUTHKEY=SUA_CHAVE_TOKEN_AUTH_DO_BUNNY
ND_CDN_TOKENTTL=24h
# Deixe vazio se a Pull Zone aponta para a raiz do bucket.
ND_CDN_PATH_PREFIX=
# true = HMAC-SHA256; false = MD5 legado
ND_CDN_ADVANCEDAUTH=true

# --- Banco de dados ---
# DATABASE_URL=postgres://usuario:senha@host:5432/play-music?sslmode=disable

# --- ffmpeg / transcoding ---
ND_TRANSCODINGCACHESIZE=1GiB
ND_IMAGECACHESIZE=100MB
ND_TRANSCODING_MAXCONCURRENT=2

# --- Diversos ---
ND_LOGLEVEL=info
ND_PORT=4533
ND_ADDRESS=0.0.0.0
ND_ENABLEINSIGHTSCOLLECTOR=false
ND_SCANNER_SCHEDULE=@every 1h
