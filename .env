# ============================================================================
# Play Music — Configuração (play-music)
# ============================================================================
# Arquivo de referência. O Play Music lê variáveis de ambiente com prefixo ND_.
# Este arquivo serve como documentação e fonte para o docker-compose / Coolify.
# Valores reais de produção (MinIO, Redis, Bunny CDN, Postgres).

# --- Idiomas / Interface -----------------------------------------------------
ND_DEFAULTLANGUAGE=pt-BR
ND_DEFAULTTHEME=Dark

# --- Administrador (fonte unica das credenciais) ------------------------------
ND_ADMINUSERNAME=admin
ND_ADMINPASSWORD=123456

# --- Biblioteca / Storage (Bunny Storage Zone, S3-compatible) -----------------
# A biblioteca fica na Storage Zone "files3" do Bunny (S3 origin da Pull Zone).
ND_MUSICFOLDER=s3://files3?endpoint=jh-s3.storage.bunnycdn.com&accessKey=files3&secretKey=6b3275eb-178a-4d9d-b0bf14e898a5-73da-4225&region=us-east-1&secure=true

# --- OBSOLETO: antigo MinIO (bucket play-music) — mantido apenas para rollback
# (config.go só usa MINIO_* se ND_S3_* estiverem vazios; ND_MUSICFOLDER tem prioridade)
MINIO_ENDPOINT=minios3.centralcursoss.com.br
MINIO_ACCESS_KEY=hensi
MINIO_SECRET_KEY=samu2305
MINIO_BUCKET=play-music
# true para HTTPS (porta 443), false para HTTP (porta 80)
MINIO_USE_SSL=true
MINIO_REGION=us-east-1

# --- Bunny Storage (S3-compatible) — Storage Zone "files3" ----------------------
ND_S3_ENDPOINT=jh-s3.storage.bunnycdn.com
ND_S3_ACCESSKEY=files3
ND_S3_SECRETKEY=6b3275eb-178a-4d9d-b0bf14e898a5-73da-4225
ND_S3_BUCKET=files3
ND_S3_REGION=us-east-1
ND_S3_SECURE=true

# --- Redis — já existente no servidor Coolify ----------------------------------
ND_REDIS_ENABLED=true
ND_REDIS_URL=redis://default:zHA80XHhGMJQ607pLX1bUB72395cOx0cR2a2nNQrP0cou8RKXJWXuo9EHrZYrpHt@uxik2u1vwf2l4cb9he5vm6w7:6379/0

# --- Bunny CDN — Pull Zone apontando para a Storage Zone "files3" (Bunny) ------
ND_CDN_ENABLED=true
ND_CDN_BASEURL=https://music.centralcursoss.com.br
ND_CDN_TOKENAUTHKEY=ec090a62-4bbb-4076-b415-b64d69d117dc
ND_CDN_TOKENTTL=24h
ND_CDN_ADVANCEDAUTH=true
# Deixe vazio se a Pull Zone aponta direto para a pasta da biblioteca no bucket.
ND_CDN_PATH_PREFIX=

# --- Postgres — já existente no servidor Coolify ---------------------------------
# O Play Music usa SQLite para o catálogo. Esta conexão é para o backend/produto
# play-music (web, pagamentos, analytics).
DATABASE_URL=postgres://postgres:1aY0vrCiAunDJxamzVSJwqhP5R08a4ro1i9yoA03LGFNLUXuBvz6ocLSvDzoFfUS@72.62.11.235:5432/play-music?sslmode=disable

# --- ffmpeg ---------------------------------------------------------------------
# Em produção o ffmpeg vem na imagem Docker. Localmente, informe o caminho se
# não estiver no PATH.
# ND_FFMPEGPATH=C:\ffmpeg\bin\ffmpeg.exe

# --- Avançado -------------------------------------------------------------------
ND_LOGLEVEL=info
ND_PORT=4533
ND_ADDRESS=0.0.0.0
ND_SCANNER_SCHEDULE=@every 1h
ND_TRANSCODINGCACHESIZE=500MiB
ND_IMAGECACHESIZE=100MB
ND_ENABLEINSIGHTSCOLLECTOR=false
