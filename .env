# ============================================================================
# Navidrome — Configuração (play-music)
# ============================================================================
# Arquivo de referência. O Navidrome lê variáveis de ambiente com prefixo ND_.
# Este arquivo serve como documentação e fonte para o docker-compose / Coolify.
# Preencha os valores reais antes do deploy.

# --- Idiomas / Interface -----------------------------------------------------
ND_DEFAULTLANGUAGE=pt-BR
ND_DEFAULTTHEME=Dark

# --- Biblioteca / Storage -----------------------------------------------------
# O Navidrome usa MusicFolder para bibliotecas locais. Com o backend S3 (Fase 2),
# a biblioteca passa a ser configurada via URI de storage:
# ND_STORAGE_URI=s3://<bucket>?endpoint=<minio>:9000&accessKey=...&secretKey=...&secure=false
ND_MUSICFOLDER=./music

# --- MinIO (S3-compatible) — já existente no servidor Coolify -----------------
MINIO_ENDPOINT=minio.seudominio.com.br
MINIO_PORT=9000
MINIO_ACCESS_KEY=SEU_ACCESS_KEY
MINIO_SECRET_KEY=SEU_SECRET_KEY
MINIO_BUCKET=navidrome-music
MINIO_BUCKET_TRANSCODE=navidrome-transcode
MINIO_SECURE=false

# --- Redis — já existente no servidor Coolify ----------------------------------
ND_REDIS_ENABLED=true
ND_REDIS_URL=redis://SEU_REDIS_HOST:6379/0
ND_REDIS_PASSWORD=

# --- Bunny CDN — Pull Zone apontando para o MinIO (S3 origin) -------------------
ND_CDN_ENABLED=true
ND_CDN_BASEURL=https://music.centralcursoss.com.br
ND_CDN_TOKENAUTHKEY=SUA_CHAVE_TOKEN_AUTH_DO_BUNNY
ND_CDN_TOKENTTL=24h
ND_CDN_PATH_PREFIX=navidrome-music

# --- ffmpeg ---------------------------------------------------------------------
# Em produção o ffmpeg vem na imagem Docker. Localmente, informe o caminho se
# não estiver no PATH.
# ND_FFMPEGPATH=C:\ffmpeg\bin\ffmpeg.exe

# --- Avançado -------------------------------------------------------------------
ND_LOGLEVEL=info
ND_PORT=4533
ND_SCANNER_SCHEDULE=@every 1h
ND_TRANSCODINGCACHESIZE=500MiB
ND_IMAGECACHESIZE=100MB
