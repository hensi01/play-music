# Normalize line endings: build-critical files MUST stay LF even on Windows
# (CRLF breaks shell heredocs and scripts inside Docker/Linux containers).

# Shell scripts
*.sh text eol=lf

# Dockerfiles and compose files
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Makefiles
Makefile text eol=lf
makefile text eol=lf
*.mk text eol=lf

# C/assembly sources (compiled in the Docker image)
*.c text eol=lf
*.h text eol=lf
*.S text eol=lf

# Other dev/proc files
Procfile.dev text eol=lf
reflex.conf text eol=lf
.nvmrc text eol=lf
